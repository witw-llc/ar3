{
  "description": "solo — a bare engine node: one r4t engine turn per wake",
  "max_wake_seconds": 900,
  "invoke": ["r4t", "engine", "cursor", "run", "--timeout", "600",
             "--agent", "$RECIPIENT",
             "$SENDER tells $RECIPIENT ($AGE): $MESSAGE"],
  "batch": {
    "limit": 20,
    "invoke": ["r4t", "engine", "cursor", "run", "--timeout", "600",
               "--agent", "$RECIPIENT"]
  },
  "idle": {
    "timeout": 900,
    "invoke": ["r4t", "engine", "cursor", "run", "--timeout", "600",
               "--idle", "--agent", "$RECIPIENT"]
  }
}
