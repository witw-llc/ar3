{
  "description": "Send prompts to Gemini through a signed-in browser profile.",
  "invoke": [
    "$PYTHON",
    "$A8S_DIR/../tools/gemini_web",
    "handle",
    "--seat",
    "$RECIPIENT",
    "--from",
    "$SENDER",
    "--allow",
    "$ALLOW",
    "--browser-seat",
    "$BROWSER_SEAT",
    "--model=$MODEL?",
    "--",
    "$MESSAGE"
  ],
  "max_wake_seconds": 900,
  "idle": {
    "timeout": "$TIMEOUT?",
    "invoke": [
      "$PYTHON",
      "$A8S_DIR/../tools/browser",
      "idle",
      "--seat",
      "$BROWSER_SEAT",
      "--timeout=$TIMEOUT?"
    ]
  },
  "stop": {
    "invoke": [
      "$PYTHON",
      "$A8S_DIR/../tools/browser",
      "close",
      "--seat",
      "$BROWSER_SEAT"
    ]
  }
}
