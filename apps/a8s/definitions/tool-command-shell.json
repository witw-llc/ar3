{
  "description": "Run shell commands and return their output.",
  "invoke": [
    "$PYTHON",
    "$A8S_DIR/../tools/command_shell",
    "--seat",
    "$RECIPIENT",
    "--from",
    "$SENDER",
    "--allow",
    "$ALLOW",
    "--shell=$SHELL?",
    "--timeout=$TIMEOUT?",
    "--inline-max=$INLINE_MAX?",
    "--output-max=$OUTPUT_MAX?",
    "--",
    "$MESSAGE"
  ],
  "max_wake_seconds": 600,
  "idle": {
    "timeout": 0
  }
}
