{
  "description": "Store and retrieve encrypted files for agents.",
  "invoke": [
    "$PYTHON",
    "$A8S_DIR/../tools/vault",
    "handle",
    "--seat",
    "$RECIPIENT",
    "--from",
    "$SENDER",
    "--dir=$VAULT_DIR?",
    "--openssl=$OPENSSL?",
    "--",
    "$MESSAGE"
  ],
  "max_wake_seconds": 300,
  "idle": {
    "timeout": 0
  }
}
