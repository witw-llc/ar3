{
  "description": "Run browser commands in a saved Chrome profile.",
  "invoke": [
    "$PYTHON",
    "$A8S_DIR/../tools/browser",
    "handle",
    "--seat",
    "$RECIPIENT",
    "--from",
    "$SENDER",
    "--allow",
    "$ALLOW",
    "--allow-eval=$ALLOW_EVAL?",
    "--chrome=$CHROME?",
    "--",
    "$MESSAGE"
  ],
  "max_wake_seconds": 600,
  "idle": {
    "timeout": "$TIMEOUT?",
    "invoke": [
      "$PYTHON",
      "$A8S_DIR/../tools/browser",
      "idle",
      "--seat",
      "$RECIPIENT",
      "--timeout=$TIMEOUT?",
      "--chrome=$CHROME?"
    ]
  },
  "stop": {
    "invoke": [
      "$PYTHON",
      "$A8S_DIR/../tools/browser",
      "close",
      "--seat",
      "$RECIPIENT",
      "--chrome=$CHROME?"
    ]
  }
}
